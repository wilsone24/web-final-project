{
  "name": "cardiopredict-backend",
  "version": "1.0.0",
  "description": "Proxy Node.js (TypeScript) que reenvía peticiones al endpoint de Databricks y al SQL warehouse, ocultando el bearer token y resolviendo CORS.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@databricks/sql": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
