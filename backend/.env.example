DATABRICKS_TOKEN=tu_token_model_serving
DATABRICKS_ENDPOINT_URL=https://adb-xxxxxxxxxxxxxxx.x.azuredatabricks.net/serving-endpoints/cardio-classifier-endpoint/invocations

DATABRICKS_SQL_HOST=adb-xxxxxxxxxxxxxxx.x.azuredatabricks.net
DATABRICKS_SQL_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_SQL_TOKEN=tu_token_sql_warehouse
DATABRICKS_CATALOG=databricks_service_pf
DATABRICKS_SCHEMA=gold

# /model-info — opcional. Si no defines DATABRICKS_WORKSPACE_HOST, el backend
# lo deriva de DATABRICKS_ENDPOINT_URL.
DATABRICKS_WORKSPACE_HOST=https://adb-xxxxxxxxxxxxxxx.x.azuredatabricks.net
    DATABRICKS_MODEL_NAME=databricks_service_pf.gold.cardio_classifier

# Opcional — habilita el análisis con IA bajo el gauge en /predict (individual).
# Si esta variable no está, el feature se oculta automáticamente del frontend.
OPENAI_API_KEY=sk-tu_api_key_de_openai
OPENAI_MODEL=gpt-4o

PORT=8000